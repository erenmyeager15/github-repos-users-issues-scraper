{
  "actorSpecification": 1,
  "name": "github-repos-users-issues-scraper",
  "title": "GitHub Scraper - Repos, Users & Issues",
  "description": "Scrape GitHub repositories, users, and issues via the official GitHub API. Get stars, forks, languages, topics, issues, user profiles, and follower counts. No login needed (optional token for higher limits).",
  "version": "1.0",
  "categories": ["DEVELOPER_TOOLS", "OTHER"],
  "dockerfile": "Dockerfile",
  "input": "../INPUT_SCHEMA.json",
  "output": "./output_schema.json",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "views": {
        "repos": {
          "title": "Repositories",
          "transformation": {
            "fields": ["fullName", "owner", "description", "language", "stars", "forks", "watchers", "openIssues", "license", "topics", "isFork", "isArchived", "createdAt", "pushedAt", "url", "issuesScrapedCount", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "fullName": { "label": "Repo", "format": "text" },
              "owner": { "label": "Owner", "format": "text" },
              "description": { "label": "Description", "format": "text" },
              "language": { "label": "Language", "format": "text" },
              "stars": { "label": "Stars", "format": "number" },
              "forks": { "label": "Forks", "format": "number" },
              "watchers": { "label": "Watchers", "format": "number" },
              "openIssues": { "label": "Open Issues", "format": "number" },
              "license": { "label": "License", "format": "text" },
              "topics": { "label": "Topics", "format": "array" },
              "isFork": { "label": "Fork", "format": "boolean" },
              "isArchived": { "label": "Archived", "format": "boolean" },
              "createdAt": { "label": "Created", "format": "date" },
              "pushedAt": { "label": "Last Push", "format": "date" },
              "url": { "label": "URL", "format": "link" },
              "issuesScrapedCount": { "label": "Issues", "format": "number" },
              "scrapedAt": { "label": "Scraped At", "format": "text" }
            }
          }
        },
        "users": {
          "title": "Users and organizations",
          "transformation": {
            "fields": ["login", "name", "type", "company", "location", "followers", "following", "publicRepos", "publicGists", "url", "reposScrapedCount", "scrapedAt"]
          },
          "display": {
            "component": "table",
            "properties": {
              "login": { "label": "Login", "format": "text" },
              "name": { "label": "Name", "format": "text" },
              "type": { "label": "Type", "format": "text" },
              "company": { "label": "Company", "format": "text" },
              "location": { "label": "Location", "format": "text" },
              "followers": { "label": "Followers", "format": "number" },
              "following": { "label": "Following", "format": "number" },
              "publicRepos": { "label": "Public Repos", "format": "number" },
              "publicGists": { "label": "Public Gists", "format": "number" },
              "url": { "label": "URL", "format": "link" },
              "reposScrapedCount": { "label": "Nested Repos", "format": "number" },
              "scrapedAt": { "label": "Scraped At", "format": "text" }
            }
          }
        }
      }
    }
  },
  "pricingInfo": {
    "pricingModel": "PAY_PER_EVENT",
    "pricingPerEvent": {
      "actorChargeEvents": {
        "repo-scraped": {
          "eventTitle": "GitHub record scraped",
          "eventDescription": "Charged once for each clean GitHub repository or user profile saved to a dataset. Nested issues and user repositories are included when enabled.",
          "eventPriceUsd": 0.002
        }
      }
    }
  },
  "defaultRunOptions": {
    "build": "latest",
    "memoryMbytes": 512,
    "timeoutSecs": 3600
  },
  "minMemoryMbytes": 256,
  "maxMemoryMbytes": 4096
}
